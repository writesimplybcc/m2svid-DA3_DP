# StereoFaster environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# =============================================================================
# Hugging Face
# =============================================================================
# Required for authenticated downloads of DA3 models (removes rate limit warnings)
HF_TOKEN=hf_your_token_here

# Optional: custom cache location for models (highly recommended for large DA3/M2SVid weights)
# HF_HOME=C:/Users/yourname/.cache/huggingface

# Faster downloads (recommended)
HF_HUB_ENABLE_HF_TRANSFER=1

# =============================================================================
# StereoFaster specific (optional overrides)
# =============================================================================
# You can override defaults here if desired
# SERVER_PORT=7878
